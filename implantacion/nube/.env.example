# Copiar a .env en la VM y cambiar los valores. El archivo .env no se sube al repositorio.
DOMINIO=logistica-grupod.eastus2.cloudapp.azure.com
DB_USER=logistica
DB_PASSWORD=cambiar-por-una-clave-larga
# Clave para firmar los tokens JWT, minimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRETO=cambiar-por-una-clave-generada
