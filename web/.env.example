# Copiar a .env (no se versiona) y ajustar si el backend no corre en el puerto por defecto.
VITE_API_URL=http://localhost:8080

# true: la web exige login (POST /api/auth/login; el backend debe correr con SEGURIDAD_HABILITADA=true). false: sin login, solo si el backend tiene la seguridad apagada.
VITE_AUTH_HABILITADA=true
